\begin{center}
\caption{Summary of overall model performance during the validation phase for averaged states, ordered by ascending WIS}
\label{tab:table_validation_states}
<<echo=FALSE, eval=TRUE, results=tex>>=
table_validation_states <- tar_read(overall_validation_states, store="../../_targets") %>%
  xtable()
print(table_validation_states, booktabs=FALSE, floating=FALSE)
@
\end{center}
\end{table}

